{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "status",
  "description": "Statements each labelled with a state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "text"
        ],
        "properties": {
          "state": {
            "enum": [
              "決定",
              "予定",
              "未決",
              "取り下げ"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "width": {
      "enum": [
        "half"
      ],
      "description": "Draw the part at half width beside the next half part"
    }
  }
}
