{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "steps",
  "description": "A numbered sequence of stages",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "width": {
      "enum": [
        "half"
      ],
      "description": "Draw the part at half width beside the next half part"
    }
  }
}
