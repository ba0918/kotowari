{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lead",
  "description": "The conclusion and its points, placed first in a document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conclusion"
  ],
  "properties": {
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "width": {
      "enum": [
        "half"
      ],
      "description": "Draw the part at half width beside the next half part"
    }
  }
}
